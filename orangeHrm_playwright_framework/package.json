{
  "name": "orangehrm-playwright-cucumber-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Playwright, TypeScript and Cucumber BDD framework for OrangeHRM",
  "scripts": {
    "test": "cucumber-js",
    "smoke": "cucumber-js --tags \"@smoke\"",
    "regression": "cucumber-js --tags \"@regression\"",
    "chrome": "cross-env BROWSER=chromium cucumber-js",
    "report": "playwright show-report reports/playwright"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "cross-env": "^10.0.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^17.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
